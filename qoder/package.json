{
  "name": "studylens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StudyLens — seekdb 驱动的学习资料检索工作台（OceanBase 2026 大赛 Qoder 赛题）",
  "main": "src/serve.mjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "selfcheck": "node main.mjs",
    "smoke": "node main.mjs",
    "start": "node main.mjs --serve",
    "serve": "node main.mjs --serve",
    "dev": "node main.mjs --serve",
    "preview": "node main.mjs --serve",
    "ingest": "node src/ingest.mjs",
    "search": "node src/search.mjs",
    "export": "node src/search.mjs --export"
  },
  "optionalDependencies": {},
  "comment_optional": "seekdb 依赖不在这里：主包保持零依赖，npm install 在离线环境也能立即成功。重建索引时再按 README 安装 @oceanbase/seekdb-node 与 mysql2。",
  "bin": {
    "studylens": "main.mjs"
  }
}
